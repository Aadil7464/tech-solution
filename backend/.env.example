NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tech_solution_agency
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
UPLOAD_DIR=uploads
# Used only by npm run bootstrap; never use a shared default password
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_ROLE=admin

# Optional server-side enquiry notifications. Never expose these in NEXT_PUBLIC variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_NOTIFICATION_EMAIL=digitalmitra@gmail.com

# Optional Microsoft Graph Excel integration (server-side client credentials only).
# Do not add NEXT_PUBLIC_ prefixes. Configure all six values for a Microsoft 365
# business/organizational account and use placeholders until the workbook is tested.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_DRIVE_ID=
MS_WORKBOOK_ID=
MS_TABLE_NAME=ContactLeads
MS_GRAPH_TIMEOUT_MS=15000
